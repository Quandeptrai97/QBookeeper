{
  "manifest_version": 3,
  "name": "QBookeeper",
  "key": "",
  "version": "1.0.0",
  "description": "Right-click to bookmark and auto-categorize via Gemini",
  "permissions": [
    "bookmarks",
    "contextMenus",
    "scripting",
    "activeTab",
    "identity"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "268633933026-dh96kqdmghhmd9ts31otk33394m2u97m.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/generative-language.retriever"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "add-qbookmark": {
      "suggested_key": {
        "default": "Ctrl+B",
        "mac": "Command+B"
      },
      "description": "Add QBookmark for the current page"
    }
  }
}
