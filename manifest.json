{
  "manifest_version": 3,
  "name": "Bookeeper",
  "version": "1.0.0",
  "description": "Enhanced bookmarks page with a powerful search bar",
  "permissions": [
    "bookmarks",
    "favicon"
  ],
  "host_permissions": [
    "http://localhost:4000/*"
  ],
  "chrome_url_overrides": {
    "bookmarks": "bookmarks.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}